# ---------------------------------------------------------------------------
# AI Email Processing Platform — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
# ---------------------------------------------------------------------------

# IMAP account passwords (one per account configured in application.yml)
IMAP_PASSWORD_PERSONAL=changeme

# API key for the management / reload endpoints (POST /api/reload/*)
RELOAD_API_KEY=changeme
