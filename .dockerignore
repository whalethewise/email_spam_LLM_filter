# ---------------------------------------------------------------------------
# Shared .dockerignore for both Dockerfile and Dockerfile.runtime
# ---------------------------------------------------------------------------
#
# Dockerfile (multi-stage) needs: gradlew, gradle/, build.gradle.kts,
#   settings.gradle.kts, src/
# Dockerfile.runtime needs: build/libs/*.jar
#
# Everything else is excluded from the build context.
# ---------------------------------------------------------------------------

# Gradle caches (the wrapper JAR in gradle/ is kept)
.gradle/

# IDE
.idea/
*.iws
*.iml
*.ipr
out/

# Git
.git/
.gitignore

# Runtime config and data (volume-mounted, not baked into the image)
config/application.yml
data/
.env
*.env

# Documentation
*.md
LICENSE

# CI/CD
.github/

# Build outputs that aren't the final JAR
build/classes/
build/generated/
build/reports/
build/test-results/
build/tmp/
